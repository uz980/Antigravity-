<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer Orbital Ring -->
    <path
        android:pathData="M30,54 A24,14 0 1,0 78,54 A24,14 0 1,0 30,54"
        android:strokeWidth="2"
        android:strokeColor="#7C4DFF" />

    <!-- Tilted Antigravity Gyro Ring -->
    <path
        android:pathData="M36,36 A26,26 45 1,0 72,72 A26,26 45 1,0 36,36"
        android:strokeWidth="1.8"
        android:strokeColor="#00E5FF" />

    <!-- Core Levitating Diamond Prism -->
    <path
        android:pathData="M54,34 L70,54 L54,74 L38,54 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#FFFFFF">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38"
                android:startY="34"
                android:endX="70"
                android:endY="74"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#7C4DFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Coding Chevron Left < -->
    <path
        android:pathData="M48,49 L43,54 L48,59"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Coding Chevron Right > -->
    <path
        android:pathData="M60,49 L65,54 L60,59"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Anti-gravity particle dots -->
    <path
        android:pathData="M54,26 A2.5,2.5 0 1,1 54,21 A2.5,2.5 0 1,1 54,26"
        android:fillColor="#00E5FF" />
    <path
        android:pathData="M54,87 A2.5,2.5 0 1,1 54,82 A2.5,2.5 0 1,1 54,87"
        android:fillColor="#7C4DFF" />
    <path
        android:pathData="M23,54 A2,2 0 1,1 23,50 A2,2 0 1,1 23,54"
        android:fillColor="#00E5FF" />
    <path
        android:pathData="M85,54 A2,2 0 1,1 85,50 A2,2 0 1,1 85,54"
        android:fillColor="#00E5FF" />
</vector>
